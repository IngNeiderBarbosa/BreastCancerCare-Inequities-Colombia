<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="false">
  <code><![CDATA[;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; ========================================================
;; SIMULACIÓN DE TRAYECTORIAS DE ATENCIÓN
;; CÁNCER DE MAMA - COLOMBIA
;;
;; VERSION v2.7.1
;;
;; PRINCIPIO METODOLÓGICO
;; --------------------------------------------------------
;; Esta versión NO incorpora relaciones con AÑO.
;;
;; Las dependencias se introducen únicamente cuando están
;; respaldadas por las matrices de correlación utilizadas
;; en el artículo/capítulo de soporte.
;;
;; Estructuras preservadas:
;;
;; BOGOTÁ
;;   régimen <-> dx-dias           ~= -0.11
;;   régimen <-> tx-dias           ~= -0.18
;;   dx-dias <-> tx-dias           ~= +0.07
;;
;; SOCORRO
;;   lactancia <-> masa izquierda  ~= -0.15
;;   masa izquierda <-> masa der.  ~= +0.10
;;   hijos <-> edad                ~= +0.10
;;
;; NOTAS:
;; - Masa izquierda <-> masa derecha se conserva como
;;   dependencia de perfil, aunque la tabla original
;;   advierte que su magnitud no fue significativa.
;; - Hijos <-> edad se conserva como estructura de perfil.
;;   NO se interpreta como efecto causal sobre la carga.
;; - Antecedentes se conserva por su marginal, pero no se
;;   fuerza un efecto sobre la carga al no existir una
;;   asociación fuerte documentada en las matrices.
;;
;; CARGA ASISTENCIAL
;; --------------------------------------------------------
;; Se separan:
;;   carga-temporal  = carga por días de Dx + Tx
;;   carga-clinica   = ajuste relacional pequeño
;;   carga-total     = suma de ambas
;;
;; El ajuste clínico NO se inventa como una penalización
;; fija. Se usa la magnitud observada de rho=-0.15 como
;; modificador proporcional cuando aparece el patrón
;; masa izquierda presente + ausencia de lactancia.
;;
;; Por tanto:
;;
;; carga-clinica = carga-temporal * 0.15
;;
;; únicamente para ese patrón relacional.
;;
;; Este ajuste es EXPLORATORIO, NO causal, y debe ser
;; sometido a análisis de sensibilidad.
;;
;; La energía residual sigue siendo un índice sintético:
;;
;; energia = max(0, energia-inicial - carga-total)
;;
;; No representa reserva fisiológica ni una escala clínica.
;; ========================================================
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; VARIABLES DE LOS AGENTES
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

turtles-own [

  ;; Tiempos
  dx-dias
  tx-dias

  ;; Velocidades visuales
  dx-vel
  tx-vel

  ;; Contadores temporales
  dias-etapa
  dias-acumulados

  ;; Edad
  edad
  grupo-edad

  ;; Variables clínicas y reproductivas
  antecedentes
  hijos
  lactante?
  masa-izq?
  masa-der?

  ;; Régimen
  regimen

  ;; Componentes de carga
  carga-temporal
  modificador-clinico
  carga-clinica
  carga-total

  ;; Estado
  estado-final
  energia
  etapa
  registrado?
  ultimo-estado-alcanzado
]


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; VARIABLES GLOBALES
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

globals [

  energia-final

  ;; Probabilidades clínicas/reproductivas
  p-antecedentes
  p-hijos
  p-lactancia
  p-masa-izq
  p-masa-der

  ;; Mortalidad
  p-mortalidad

  ;; Régimen
  p-contributivo
  p-subsidiado
  p-especial

  ;; Bogotá
  rho-reg-dx-objetivo
  rho-reg-tx-objetivo
  rho-dx-tx-objetivo

  rho-latente-reg-dx
  rho-latente-reg-tx
  rho-latente-dx-tx

  ;; Socorro
  rho-lact-masaizq-objetivo
  rho-masaizq-masader-objetivo
  rho-edad-hijos-objetivo

  rho-latente-lact-masaizq
  rho-latente-masaizq-masader
  rho-latente-edad-hijos

  ;; Edad: aproximación marginal de Socorro
  media-edad-socorro
  sd-edad-socorro
  edad-minima
  edad-maxima

  ;; Índice sintético
  energia-inicial
  costo-diario-energia

  ;; Visual
  distancia-etapa
]


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; CONFIGURACIÓN
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to configurar-parametros

  ;; ======================================================
  ;; MARGINALES CLÍNICAS / REPRODUCTIVAS
  ;; ======================================================

  set p-antecedentes 0.0774
  set p-hijos        0.8409
  set p-lactancia    0.7022
  set p-masa-izq     0.0753
  set p-masa-der     0.0935

  ;; Mortalidad programada
  set p-mortalidad 0.0537

  ;; Régimen
  set p-contributivo 0.51
  set p-subsidiado   0.37
  set p-especial     0.12


  ;; ======================================================
  ;; DEPENDENCIAS BOGOTÁ
  ;; ======================================================
  ;;
  ;; Objetivos extraídos de la matriz:
  ;; régimen <-> Dx ~= -0.11
  ;; régimen <-> Tx ~= -0.18
  ;; Dx <-> Tx      ~= +0.07
  ;;
  ;; Los coeficientes latentes fueron calibrados para
  ;; aproximar los Spearman finales después de Cauchy,
  ;; log, ruido Normal y redondeo.

  set rho-reg-dx-objetivo -0.11
  set rho-reg-tx-objetivo -0.18
  set rho-dx-tx-objetivo   0.07

  set rho-latente-reg-dx -0.30
  set rho-latente-reg-tx -0.63

  ;; Correlación entre los componentes residuales de Dx/Tx.
  ;; Calibrada para producir Spearman final ~ +0.07.
  set rho-latente-dx-tx 0.135


  ;; ======================================================
  ;; DEPENDENCIAS SOCORRO
  ;; ======================================================

  ;; Lactancia <-> masa izquierda ~= -0.15
  set rho-lact-masaizq-objetivo -0.15
  set rho-latente-lact-masaizq -0.33

  ;; Masa izquierda <-> masa derecha ~= +0.10
  ;; Se conserva como estructura de perfil, NO como efecto
  ;; directo de carga.
  set rho-masaizq-masader-objetivo 0.10
  set rho-latente-masaizq-masader 0.26

  ;; Hijos <-> edad ~= +0.10
  ;;
  ;; Debido a que HIJOS=SI se obtiene con u < p-hijos,
  ;; el signo latente requerido es negativo para obtener
  ;; una correlación positiva entre edad e hijos.
  set rho-edad-hijos-objetivo 0.10
  set rho-latente-edad-hijos -0.155


  ;; ======================================================
  ;; EDAD
  ;; ======================================================
  ;;
  ;; Aproximación marginal a partir del dataset de Socorro.
  ;; Se usa Normal truncada para mantener el modelo
  ;; autocontenido y evitar depender de archivos externos.
  ;;
  ;; Estos parámetros NO crean una relación con AÑO.

  set media-edad-socorro 49.759813
  set sd-edad-socorro    11.673710

  set edad-minima 15
  set edad-maxima 80


  ;; ======================================================
  ;; ÍNDICE DE CARGA
  ;; ======================================================

  set energia-inicial 100
  set costo-diario-energia 1


  ;; ======================================================
  ;; VISUAL
  ;; ======================================================

  set distancia-etapa 10

end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; FUNCIONES
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to-report normal-cdf [valor-z]

  let x ((abs valor-z) / sqrt 2)
  let t (1 / (1 + 0.3275911 * x))

  let a1 0.254829592
  let a2 -0.284496736
  let a3 1.421413741
  let a4 -1.453152027
  let a5 1.061405429

  let polinomio
    (((((a5 * t + a4) * t + a3) * t + a2) * t + a1) * t)

  let erf-aprox
    (1 - polinomio * exp (-1 * x * x))

  if valor-z < 0 [
    set erf-aprox (-1 * erf-aprox)
  ]

  report 0.5 * (1 + erf-aprox)

end


to-report limitar-u [valor-u]

  let valor valor-u

  if valor < 0.000001 [
    set valor 0.000001
  ]

  if valor > 0.999999 [
    set valor 0.999999
  ]

  report valor

end


to-report cauchy-desde-u [valor-u param-loc param-escala]

  let uc limitar-u valor-u

  report param-loc + param-escala * tan (180 * (uc - 0.5))

end


to-report cauchy-random [param-loc param-escala]

  let u (0.000001 + random-float 0.999998)

  report cauchy-desde-u u param-loc param-escala

end


;; Grupo quinquenal de edad.
;; 1=15-19, 2=20-24, ..., 13=75-79, 14=80+.

to-report grupo-edad-de [valor-edad]

  if valor-edad < 20 [ report 1 ]
  if valor-edad < 25 [ report 2 ]
  if valor-edad < 30 [ report 3 ]
  if valor-edad < 35 [ report 4 ]
  if valor-edad < 40 [ report 5 ]
  if valor-edad < 45 [ report 6 ]
  if valor-edad < 50 [ report 7 ]
  if valor-edad < 55 [ report 8 ]
  if valor-edad < 60 [ report 9 ]
  if valor-edad < 65 [ report 10 ]
  if valor-edad < 70 [ report 11 ]
  if valor-edad < 75 [ report 12 ]
  if valor-edad < 80 [ report 13 ]

  report 14

end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; CÁLCULO DE CARGA
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to actualizar-carga

  ;; ------------------------------------------------------
  ;; 1. CARGA TEMPORAL
  ;; ------------------------------------------------------
  ;;
  ;; Conserva la idea de que más días asistenciales
  ;; representan mayor carga.
  ;;
  ;; Se limita a la escala 0-100 para mantener
  ;; compatibilidad con el índice residual.

  set carga-temporal
    min list
    energia-inicial
    (dias-acumulados * costo-diario-energia)


  ;; ------------------------------------------------------
  ;; 2. MODIFICADOR CLÍNICO RELACIONAL
  ;; ------------------------------------------------------
  ;;
  ;; ÚNICO modificador directo incorporado en v2.7:
  ;;
  ;; lactancia <-> masa izquierda ~= -0.15
  ;;
  ;; La asociación ya se preserva en la generación de los
  ;; atributos. Para representar su posible contribución
  ;; pequeña a la carga acumulada, se activa un modificador
  ;; proporcional de |rho| cuando aparece el patrón:
  ;;
  ;; NO lactancia + masa izquierda presente.
  ;;
  ;; Esto NO se interpreta como causalidad ni como riesgo
  ;; clínico. Es una parametrización exploratoria derivada
  ;; exclusivamente de la magnitud de la matriz original.

  set modificador-clinico 0

  if (not lactante?) and masa-izq? [

    set modificador-clinico
      abs rho-lact-masaizq-objetivo

  ]


  ;; El modificador actúa de forma proporcional sobre la
  ;; carga temporal. Así, rho=0.15 equivale a un ajuste
  ;; relativo del 15 %, no a una penalización fija inventada.

  set carga-clinica
    carga-temporal * modificador-clinico


  ;; ------------------------------------------------------
  ;; 3. CARGA TOTAL
  ;; ------------------------------------------------------

  set carga-total
    min list
    energia-inicial
    (carga-temporal + carga-clinica)


  ;; ------------------------------------------------------
  ;; 4. ENERGÍA RESIDUAL SINTÉTICA
  ;; ------------------------------------------------------

  set energia
    max list
    0
    (energia-inicial - carga-total)

end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; SETUP
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to setup

  clear-all

  configurar-parametros

  set energia-final 0


  ;; ======================================================
  ;; CSV
  ;; ======================================================

  file-close-all

  let archivo
    (word user-directory "resultados.csv")

  if file-exists? archivo [
    file-delete archivo
  ]

  file-open archivo

  file-print
  "dx-dias,tx-dias,dias-acumulados,edad,grupo-edad,antecedentes,hijos,lactante?,masa-izq?,masa-der?,regimen,estado-final,ultimo-estado-alcanzado,carga-temporal,modificador-clinico,carga-clinica,carga-total,energia"


  ;; ======================================================
  ;; AGENTES
  ;; ======================================================

  create-turtles numero-tortugas [

    setxy -15 random-ycor
    set heading 90


    ;; ====================================================
    ;; A. BOGOTÁ: RÉGIMEN + Dx + Tx
    ;; ====================================================

    let z-regimen
      random-normal 0 1

    let u-regimen
      normal-cdf z-regimen


    ifelse u-regimen < p-contributivo [

      set regimen "contributivo"

    ] [

      ifelse
        u-regimen < (p-contributivo + p-subsidiado)
      [

        set regimen "subsidiado"

      ] [

        set regimen "especial"

      ]
    ]


    ;; ----------------------------------------------------
    ;; Diagnóstico
    ;; ----------------------------------------------------

    let e-dx
      random-normal 0 1

    let sd-independiente-dx
      sqrt (1 - (rho-latente-reg-dx * rho-latente-reg-dx))

    let z-dx
      (rho-latente-reg-dx * z-regimen
       + sd-independiente-dx * e-dx)

    let u-dx
      normal-cdf z-dx

    let raw-dx
      cauchy-desde-u u-dx 8.153226 3.325101

    let val-dx
      ln (abs raw-dx + 1) * 10

    let ruido-dx
      random-normal 0 5

    set dx-dias
      max list 1 round (val-dx + ruido-dx)


    ;; ----------------------------------------------------
    ;; Tratamiento
    ;;
    ;; Se conserva:
    ;; - dependencia con régimen
    ;; - dependencia pequeña Dx <-> Tx
    ;; ----------------------------------------------------

    let e-tx-independiente
      random-normal 0 1

    let e-tx-correlacionado
      (rho-latente-dx-tx * e-dx
       + sqrt (1 - (rho-latente-dx-tx * rho-latente-dx-tx))
         * e-tx-independiente)

    let sd-independiente-tx
      sqrt (1 - (rho-latente-reg-tx * rho-latente-reg-tx))

    let z-tx
      (rho-latente-reg-tx * z-regimen
       + sd-independiente-tx * e-tx-correlacionado)

    let u-tx
      normal-cdf z-tx

    let raw-tx
      cauchy-desde-u u-tx 29.10418 23.64657

    let val-tx
      ln (abs raw-tx + 1) * 10

    let ruido-tx
      random-normal 0 5

    set tx-dias
      max list 1 round (val-tx + ruido-tx)


    ;; Velocidades visuales

    set dx-vel
      distancia-etapa / dx-dias

    set tx-vel
      distancia-etapa / tx-dias


    ;; ====================================================
    ;; B. SOCORRO: EDAD + HIJOS
    ;; ====================================================
    ;;
    ;; Edad NO depende de año.
    ;;
    ;; Hijos se genera con una estructura latente que
    ;; aproxima Spearman(edad,hijos) ~= +0.10 y conserva
    ;; P(hijos=SI)=0.8409.

    let z-edad
      random-normal 0 1

    set edad
      round (media-edad-socorro + sd-edad-socorro * z-edad)

    if edad < edad-minima [
      set edad edad-minima
    ]

    if edad > edad-maxima [
      set edad edad-maxima
    ]

    set grupo-edad
      grupo-edad-de edad


    let e-hijos
      random-normal 0 1

    let z-hijos
      (rho-latente-edad-hijos * z-edad
       + sqrt (1 - (rho-latente-edad-hijos * rho-latente-edad-hijos))
         * e-hijos)

    let u-hijos
      normal-cdf z-hijos

    set hijos
      (u-hijos < p-hijos)


    ;; ====================================================
    ;; C. SOCORRO: LACTANCIA + MASAS
    ;; ====================================================

    set antecedentes
      (random-float 1 < p-antecedentes)


    ;; Lactancia

    let z-lactancia
      random-normal 0 1

    let u-lactancia
      normal-cdf z-lactancia

    set lactante?
      (u-lactancia < p-lactancia)


    ;; Masa izquierda condicionada por la estructura
    ;; latente de lactancia.

    let sd-independiente-masaizq
      sqrt (1 - (rho-latente-lact-masaizq
                 * rho-latente-lact-masaizq))

    let z-masaizq
      (rho-latente-lact-masaizq * z-lactancia
       + sd-independiente-masaizq * (random-normal 0 1))

    let u-masaizq
      normal-cdf z-masaizq

    set masa-izq?
      (u-masaizq < p-masa-izq)


    ;; Masa derecha con relación débil con masa izquierda.
    ;; Se conserva la marginal P(SI)=0.0935.

    let sd-independiente-masader
      sqrt (1 - (rho-latente-masaizq-masader
                 * rho-latente-masaizq-masader))

    let z-masader
      (rho-latente-masaizq-masader * z-masaizq
       + sd-independiente-masader * (random-normal 0 1))

    let u-masader
      normal-cdf z-masader

    set masa-der?
      (u-masader < p-masa-der)


    ;; ====================================================
    ;; ESTADO INICIAL
    ;; ====================================================

    set dias-etapa 0
    set dias-acumulados 0

    set carga-temporal 0
    set modificador-clinico 0
    set carga-clinica 0
    set carga-total 0

    set energia energia-inicial

    set estado-final ""

    ;; -1 ingreso
    ;;  0 diagnóstico
    ;;  1 tratamiento
    ;;  2 evaluación
    ;;  3 terminado

    set etapa -1

    set registrado? false

    set ultimo-estado-alcanzado "ingreso"


    ;; Apariencia

    set shape "person"
    set color blue
    set size 0.45
    pen-up

  ]

  reset-ticks

end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; GO
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to go

  ask turtles [

    ;; INGRESO

    ifelse etapa = -1 [

      set ultimo-estado-alcanzado "ingreso"
      set xcor -15
      set etapa 0
      set dias-etapa 0

    ] [

      ;; DIAGNÓSTICO

      ifelse etapa = 0 [

        set color yellow

        fd dx-vel

        set dias-etapa
          dias-etapa + 1

        set dias-acumulados
          dias-acumulados + 1

        actualizar-carga

        set ultimo-estado-alcanzado
          "diagnostico"

        if dias-etapa >= dx-dias [

          set xcor -5
          set etapa 1
          set dias-etapa 0
          set color orange

        ]

      ] [

        ;; TRATAMIENTO

        ifelse etapa = 1 [

          set color orange

          fd tx-vel

          set dias-etapa
            dias-etapa + 1

          set dias-acumulados
            dias-acumulados + 1

          actualizar-carga

          set ultimo-estado-alcanzado
            "tratamiento"

          if dias-etapa >= tx-dias [

            set xcor 5
            set etapa 2
            set dias-etapa 0

          ]

        ] [

          ;; EVALUACIÓN

          if etapa = 2 [

            set ultimo-estado-alcanzado
              "evaluacion"

            set xcor 15

            ifelse
              random-float 1 < p-mortalidad
            [

              set estado-final "muerto"
              set color red

            ] [

              set estado-final "vivo"
              set color green

            ]

            set etapa 3

            registrar-resultado

          ]
        ]
      ]
    ]
  ]


  tick


  if all? turtles [etapa = 3] [

    set energia-final
      mean [energia] of turtles

    file-close

    stop

  ]

end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; REGISTRO
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to registrar-resultado

  if not registrado? [

    file-print
      (word

        dx-dias ","
        tx-dias ","
        dias-acumulados ","

        edad ","
        grupo-edad ","

        antecedentes ","
        hijos ","
        lactante? ","
        masa-izq? ","
        masa-der? ","

        regimen ","
        estado-final ","
        ultimo-estado-alcanzado ","

        carga-temporal ","
        modificador-clinico ","
        carga-clinica ","
        carga-total ","
        energia

      )

    set registrado? true

  ]

end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; REPORTER DE COLOR
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to-report palabra-color [valor-color]

  if valor-color = blue   [ report "inicio" ]
  if valor-color = yellow [ report "diagnostico" ]
  if valor-color = orange [ report "tratamiento" ]
  if valor-color = red    [ report "muerto" ]
  if valor-color = green  [ report "vivo" ]
  if valor-color = gray   [ report "indeterminado" ]

  report "otro"

end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; REPORTERS PARA INTERFAZ
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to-report muertos-en-ingreso

  report count turtles with [

    etapa = 3
    and estado-final = "indeterminado"
    and ultimo-estado-alcanzado = "ingreso"

  ]

end


to-report muertos-en-diagnostico

  report count turtles with [

    etapa = 3
    and estado-final = "indeterminado"
    and ultimo-estado-alcanzado = "diagnostico"

  ]

end


to-report muertos-en-tratamiento

  report count turtles with [

    etapa = 3
    and estado-final = "indeterminado"
    and ultimo-estado-alcanzado = "tratamiento"

  ]

end


to-report evaluados

  report count turtles with [

    etapa = 3
    and
    (
      estado-final = "vivo"
      or estado-final = "muerto"
    )

  ]

end]]></code>
  <widgets>
    <view x="515" wrappingAllowedX="true" y="36" frameRate="30.0" minPycor="-16" height="612" showTickCounter="true" patchSize="18.42424242424243" fontSize="10" wrappingAllowedY="true" width="612" tickCounterLabel="ticks" maxPycor="16" updateMode="0" maxPxcor="16" minPxcor="-16"></view>
    <button x="29" y="65" height="91" disableUntilTicks="false" forever="false" kind="Observer" width="208" display="setup">setup</button>
    <button x="29" y="161" height="92" disableUntilTicks="false" forever="true" kind="Observer" width="208">go</button>
    <monitor x="323" precision="17" y="10" height="60" fontSize="11" width="135" display="Muertos">count turtles with [estado-final = "muerto"]</monitor>
    <monitor x="323" precision="17" y="75" height="60" fontSize="11" width="135" display="Vivos">count turtles with [estado-final = "vivo"]</monitor>
    <monitor x="44" precision="17" y="652" height="60" fontSize="11" width="414" display="Promedio Energia"><![CDATA[ifelse-value any? turtles with [etapa < 3]
  [mean [energia] of turtles with [etapa < 3]]
  [energia-final]]]></monitor>
    <plot x="1136" autoPlotX="true" yMax="200.0" autoPlotY="true" yAxis="Casos Terminados" y="347" xMin="0.0" height="372" legend="true" xMax="1000.0" yMin="0.0" width="633" display="Estado Final">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="2" display="Muertos" color="-5298144" legend="true">
        <setup></setup>
        <update><![CDATA[let ind count turtles with [estado-final = "muerto"]
if ind > 0 [ plot (ind * 10)]]]></update>
      </pen>
      <pen interval="1.0" mode="2" display="Vivos" color="-14439633" legend="true">
        <setup></setup>
        <update><![CDATA[let ind count turtles with [estado-final = "vivo"]
if ind > 0 [ plot (ind * 10)]]]></update>
      </pen>
      <pen interval="1.0" mode="2" display="Inderterminados" color="-14070903" legend="true">
        <setup></setup>
        <update><![CDATA[let ind count turtles with [estado-final = "indeterminado"]
if ind > 0 [ plot (ind * 10) + 20 ]]]></update>
      </pen>
    </plot>
