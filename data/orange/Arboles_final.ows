arator': '.', 'group_separator': ''})], 'compatibility_mode': False, 'controlAreaVisible': True, 'dialog_state': {'directory': 'C:/Users/nerde/OneDrive - UCompensar/2026-2/ArticuloComplejo/Remisión de avances del artículo – Simulación y análisis de datos/Update2', 'filter': 'Text - comma separated (*.csv, *)'}, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x02 \x00\x00\x00\xae\x00\x00\x037\x00\x00\x02\x05\x00\x00\x02!\x00\x00\x00\xcc\x00\x00\x036\x00\x00\x02\x04\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\x02!\x00\x00\x00\xcc\x00\x00\x036\x00\x00\x02\x04', '__version__': 3}</properties>
