		<properties node_id="6" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x07\x7f\x00\x00\x00r\x00\x00\x0f\x00\x00\x00\x04|\x00\x00\x07\x80\x00\x00\x00\x8b\x00\x00\x0e\xff\x00\x00\x04{\x00\x00\x00\x01\x02\x00\x00\x00\x07\x80\x00\x00\x07\x80\x00\x00\x00\x8b\x00\x00\x0e\xff\x00\x00\x04{', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import numpy as np\nfrom sklearn.cluster import KMeans\nfrom Orange.data import Domain, Table, DiscreteVariable\n\ndata = in_data\n\nif data is None:\n    raise ValueError("No hay datos conectados al Python Script.")\n\n# =========================================================\n# 1. BUSCAR VARIABLES\n# =========================================================\n\nall_vars = list(data.domain.variables) + list(data.domain.metas)\n\nenergy_var = next(\n    (v for v in all_vars if v.name == "energia"),\n    None\n)\n\nif energy_var is None:\n    raise ValueError("No se encontró la variable \'energia\'.")\n\nenergia = np.asarray(\n    data.get_column(energy_var),\n    dtype=float\n)\n\nvalid = np.isfinite(energia)\n\n# =========================================================\n# 2. K-MEANS CON 3 CLASES\n# =========================================================\n\nX_energy = energia[valid].reshape(-1, 1)\n\nkmeans = KMeans(\n    n_clusters=3,\n    random_state=42,\n    n_init=20\n)\n\nraw_labels = kmeans.fit_predict(X_energy)\ncentros = kmeans.cluster_centers_.flatten()\n\n# Ordenar clusters según energía:\n# menor energía = baja\n# energía intermedia = media\n# mayor energía = alta\n\norden = np.argsort(centros)\n\ncluster_to_class = {\n    orden[0]: 0,\n    orden[1]: 1,\n    orden[2]: 2\n}\n\nlabels_ordenados = np.array(\n    [cluster_to_class[x] for x in raw_labels],\n    dtype=float\n)\n\ny = np.full(len(data), np.nan)\ny[valid] = labels_ordenados\n\nenergia_disc = DiscreteVariable(\n    "energia_disc",\n    values=("baja", "media", "alta")\n)\n\n# =========================================================\n# 3. VARIABLES PREDICTORAS\n# =========================================================\n\npredictor_names = [\n    "edad",\n    "antecedentes",\n    "hijos",\n    "lactante?",\n    "masa-izq?",\n    "masa-der?",\n    "regimen"\n]\n\npredictors = []\n\nfor name in predictor_names:\n\n    variable = next(\n        (v for v in all_vars if v.name == name),\n        None\n    )\n\n    if variable is None:\n        raise ValueError(\n            "No se encontró la variable: " + name\n        )\n\n    predictors.append(variable)\n\n# =========================================================\n# 4. DATASET FINAL PARA ORANGE\n# =========================================================\n\npredictor_domain = Domain(predictors)\n\npredictor_table = data.transform(\n    predictor_domain\n)\n\nnew_domain = Domain(\n    predictors,\n    energia_disc\n)\n\nout_data = Table.from_numpy(\n    new_domain,\n    predictor_table.X,\n    y\n)\n\n# =========================================================\n# 5. INFORMACIÓN DE CONTROL\n# =========================================================\n\ncentros_ordenados = centros[orden]\n\nprint("MODELO K-MEANS - 3 CLASES")\nprint("==========================")\nprint("Centro baja :", centros_ordenados[0])\nprint("Centro media:", centros_ordenados[1])\nprint("Centro alta :", centros_ordenados[2])\n\nprint("")\nprint("DISTRIBUCIÓN")\n\nfor i, nombre in enumerate(energia_disc.values):\n    n = int(np.sum(y == i))\n    print(\n        nombre,\n        ":",\n        n,\n        "(",\n        round(n / len(data) * 100, 2),\n        "%)"\n    )\n\nprint("")\nprint("Target: energia_disc")\nprint("Registros:", len(out_data))\n\n\n\n\n\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
